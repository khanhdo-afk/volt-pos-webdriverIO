{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard", "run", "dev"],
      "port": 4321
    },
    {
      "name": "dashboard-full",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard", "run", "dev:all"],
      "port": 4321
    },
    {
      "name": "runner-gui",
      "runtimeExecutable": "node",
      "runtimeArgs": ["dashboard/server/runner.mjs"],
      "port": 4322
    },
    {
      "name": "runner-gui-installed",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const p=require('path');process.env.APP_PATH=p.join(process.env.LOCALAPPDATA,'Volt POS','volt-pos.exe');process.env.REMOTE_DEBUG_PORT='9223';import(require('url').pathToFileURL(p.resolve('dashboard/server/runner.mjs')).href).then(m=>m.listen())"
      ],
      "port": 4322
    }
  ]
}
